# ==============================================================================
# StatIntel - Platform Root Environment Configuration Template
# Copy this file to each service's .env or use individual service configs.
# ==============================================================================

# Supabase (Database & Auth)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI (Used ONLY in ai-service, never in frontend)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Services Ports & Endpoints
PORT_BACKEND=5000
PORT_AI_SERVICE=8000
PORT_FRONTEND=5173

VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000
BACKEND_AI_SERVICE_URL=http://localhost:8000

# Source Data Directory (Points to parent directory containing iGOT, NSSTA_TPAC, Learning Materials)
SOURCE_DATA_DIR=../
PROCESSED_DATA_DIR=./data/processed
